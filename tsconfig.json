{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/.output",
    "**/.nitro",
    "packages/proxy",
    // vitest/config pulls vite's @types/node 25 next to the workspace's 22, and the
    // two ChildProcess/Worker shapes clash; vitest type-checks its own config anyway
    "vitest.config.ts"
  ]
}
